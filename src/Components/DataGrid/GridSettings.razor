@typeparam TItem

@if (ShowToggleButton)
{
    <div class="position-fixed top-50 end-0 translate-middle-y">
        <button class="btn btn-primary rounded-0 rounded-start" data-bs-toggle="offcanvas" data-bs-target="#@Id" aria-controls="@Id" title="Grid Settings">
            <i class="bi bi-sliders"></i>
        </button>
    </div>
}
<div class="offcanvas offcanvas-end" tabindex="-1" id="@Id" aria-labelledby="@(Id)Label">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="@(Id)Label">Grid Settings</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <div class="flex-grow-1">
            <div class="hdg-eyebrow mb-2">Columns</div>
            <div class="gs-columns">
                @foreach (var col in Columns)
                {
                    <div class="gs-col @col.Class"
                         draggable="@(col.IsDragable ? "true" : "false")"
                         ondragover="event.preventDefault();"
                         @ondrop="@(() => HandleDrop(col))"
                         @ondragenter="@(() => HandleDragEnter(col))"
                         @ondragleave="@(() => HandleDragLeave(col))"
                         @ondragstart="@(() => HandleDragStart(col))">
                        <i class="bi bi-grip-vertical gs-grip" @onmousedown="@(() => HandleMouseDown(col))" @onmouseup="@(() => HandleMouseUp(col))"></i>
                        <input class="form-check-input" type="checkbox" @bind="col.IsVisible">
                        <label class="form-check-label">@col.Label</label>
                    </div>
                }
            </div>

            @if (EnableGrouping && GroupableColumns.Any())
            {
                <div class="d-flex align-items-center justify-content-between gap-3 mt-4">
                    <span class="gs-ipp-label">Group by</span>
                    <select class="form-select w-auto" aria-label="Group by" value="@GroupedField" @onchange="OnGroupByChanged">
                        <option value="">None</option>
                        @foreach (var col in GroupableColumns)
                        {
                            <option value="@col.Field">@col.Label</option>
                        }
                    </select>
                </div>
            }

            <div class="d-flex align-items-center justify-content-between mt-4">
                <span class="gs-ipp-label">Items per page</span>
                <select class="form-select w-auto" aria-label="Items per page" @bind="PageSize">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>

        <div class="gs-footer">
            <button class="btn btn-outline-secondary" type="button" @onclick="DoReset" disabled="@(!EnableResetButton)">Reset</button>
            <button class="btn btn-primary" type="button" @onclick="DoSave" data-bs-toggle="offcanvas" data-bs-target="#@Id">Save</button>
        </div>
    </div>
</div>
